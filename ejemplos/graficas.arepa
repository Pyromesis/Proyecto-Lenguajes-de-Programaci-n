# ============================================================
#  graficas.arepa - Las cinco visualizaciones del lenguaje
#  Demuestra: pinte con barras, lineas, histograma,
#  dispersion y cajas, con sus cláusulas de estética.
#  Cada gráfica se escribe como PNG de 800x480 en salidas/.
# ============================================================

quihubo

ventas = monte "datos/ventas.csv" con encabezado

# Gráfica de barras exportada a PNG
pinte barras ventas
titulo "Ventas por fecha"
ejex fecha
ejey unidades
guardela "salidas/barras.png"

# Gráfica de líneas mostrada en pantalla
pinte lineas ventas
titulo "Unidades por fecha"
ejex fecha
ejey unidades
muestrela

# Histograma de una columna
pinte histograma ventas
titulo "Distribución de unidades"
ejey unidades
guardela "salidas/histograma.png"

# Dispersión
pinte dispersion ventas
titulo "Precio frente a unidades"
ejex precio
ejey unidades
guardela "salidas/dispersion.png"

# Cajas
pinte cajas ventas
titulo "Rango de precios por ciudad"
ejex ciudad
ejey precio
guardela "salidas/cajas.png"

chao
