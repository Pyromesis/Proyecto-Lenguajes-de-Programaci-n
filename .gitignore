# Bytecode de Python
__pycache__/
*.py[cod]

# Entornos virtuales
.venv/
venv/

# Salidas de ejecución (gráficas y CSV generados)
# Se ignora todo lo generado, EXCEPTO la evidencia verificable del Corte 2
salidas/*
!salidas/resumen_ciudades.csv
!salidas/resumen_ciclos.csv
!salidas/filtros_listos.csv
!salidas/README.md
!salidas/.gitkeep
