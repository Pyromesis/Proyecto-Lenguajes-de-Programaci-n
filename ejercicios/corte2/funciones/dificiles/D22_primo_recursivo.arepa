# D22 - Numero primo con ayuda recursiva
# Dificil: tiene_divisor prueba divisores desde 2 hasta pasar la raiz.

quihubo
invente tiene_divisor(n, d) {
    fijese_si (d * d > n) {
        devuelva obvio
    } sino fijese_si (n % d == 0) {
        devuelva falso
    } sino {
        devuelva tiene_divisor(n, d + 1)
    }
}
invente es_primo(n) {
    fijese_si (n < 2) {
        devuelva falso
    } sino {
        devuelva tiene_divisor(n, 2)
    }
}
cuenteme "29 primo:", es_primo(29)
cuenteme "15 primo:", es_primo(15)
cuenteme "2 primo:", es_primo(2)
chao
