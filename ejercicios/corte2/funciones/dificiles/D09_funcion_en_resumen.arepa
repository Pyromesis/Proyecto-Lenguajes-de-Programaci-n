# D09 - Funciones en flujo con junte y resuma
# Dificil: la funcion impuesto se evalua por fila dentro de cree,
# luego el pipeline agrupa y resume con agregaciones propias.

quihubo
invente impuesto(valor) {
    devuelva valor * 19 / 100
}
ventas = monte "datos/ventas.csv" con encabezado
con_imp = ventas |> cree imp = impuesto(precio)
resumen = con_imp |> junte por [ciudad] |> resuma ingreso = sume(imp), registros = cuente()
cuenteme "resumen con funcion ok"
describa resumen
chao
