# D34_deduplicacion_estable - Duplicados y prioridad
# Enunciado: Quitar duplicados exactos y comprobar qué filas permanecen.
# Esperado: {"r":{"columnas":["id","valor"],"filas":[[1,10],[2,20],[1,15]]}}
# Ejecutar desde la raíz con python src/cli/main.py ejercicios/corte2/dificiles/D34_deduplicacion_estable.arepa --ejecutar --sin-ventana

quihubo

t = arme [id, valor] con [[1, 10], [2, 20], [1, 10], [1, 15], [2, 20]]
r = t |> limpie duplicados
cuenteme r

chao
