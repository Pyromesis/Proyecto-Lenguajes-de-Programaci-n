# F34_columna_extraer - Extraer una columna
# Enunciado: Obtener las edades como lista y sumar sus valores.
# Esperado: {"edades":[20,30],"total":50}
# Ejecutar desde la raíz con python src/cli/main.py ejercicios/corte2/faciles/F34_columna_extraer.arepa --ejecutar --sin-ventana

quihubo

t = arme [nombre, edad] con [["Ana", 20], ["Luis", 30]]
edades = columna(t, edad)
total = sume(edades)
cuenteme edades, total

chao
