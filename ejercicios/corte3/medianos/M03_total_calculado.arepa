# M03_total_calculado - Importe de líneas
# Enunciado: Calcular unidades por precio y mostrar el importe de cada producto.
# Esperado: {"r":{"columnas":["producto","total"],"filas":[["A",20],["B",12]]}}
# PNG esperados: salidas/c3_M03_total_calculado.png
# Ejecutar desde la raíz con python src/cli/main.py ejercicios/corte3/medianos/M03_total_calculado.arepa --ejecutar --sin-ventana

quihubo

t = arme [producto, unidades, precio] con [["A", 2, 10], ["B", 3, 4]]
r = t |> cree total = unidades * precio |> escoja [producto, total]
cuenteme r

pinte barras r
titulo "Importe de líneas"
ejex producto
ejey total
leyenda "Serie observada"
guardela "salidas/c3_M03_total_calculado.png"

chao
