# Ejemplo verificable: 16_grafica_cajas
# Resultados exactos en ../esperados.json; ejecutar con ejecutar.py.
quihubo
t = arme [x, valor] con [[1, 2], [1, 4], [2, 3], [2, 5], [3, 6], [3, 8]]
t = t |> cree doble = valor * 2
pinte cajas t
titulo "Prueba cajas"
ejex x
ejey valor
leyenda "Valores"
guardela "salidas/cajas.png"
chao
