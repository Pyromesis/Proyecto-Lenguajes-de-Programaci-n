# F22 - mediana y desviacion (Corte 2)
# Facil: mediana con orden por insercion propio y desviacion poblacional.

quihubo
ventas = monte "datos/ventas.csv" con encabezado
resumen = ventas |> resuma mitad = mediana(unidades), desv = desviacion(unidades)
cuenteme "mediana y desviacion ok"
describa resumen
chao
